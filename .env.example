# Copiare in .env (mai committato, vedi .gitignore) e valorizzare con le
# credenziali reali del server NUT. config.ini contiene solo placeholder.
UPS_LOGIN=
UPS_PASSWORD=

# Fake GPIO. Uncomment it to run the server anywhere but on the observatory's
# production server: without it gpiozero looks for real hardware and the
# process refuses to start. It stays commented out here because this file gets
# copied into .env in production too, where an enabled mock would leave roof
# and curtains unattended while the interface keeps reporting their state.
#SERVER_GPIO_MOCK=on
