# Copiare in .env (mai committato, vedi .gitignore) e valorizzare con le
# credenziali reali del server NUT. config.ini contiene solo placeholder.
UPS_LOGIN=
UPS_PASSWORD=

# Fake GPIO, for running the server anywhere but on the observatory Raspberry
# Pi: without it gpiozero looks for real hardware and the process refuses to
# start. The deployed config.ini drives the real GPIO on purpose, so this stays
# out of the Pi's own .env.
SERVER_GPIO_MOCK=on
